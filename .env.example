# Vibe Mill environment template.
# Copy to .env and populate. Do NOT commit the populated .env.

# =========================================================================
# LLM provider (OpenRouter handles all model calls)
# =========================================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Guard and matcher do not rotate (calibration consistency).
GUARD_MODEL=anthropic/claude-haiku-4.5
MATCHER_MODEL=anthropic/claude-haiku-4.5

# Generator + README model rotation. Three parallel comma-separated lists;
# lengths must match. Weights must sum to 1.0. Reasoning efforts: disabled |
# low | medium | high. See OPERATIONS.md "Generator substrate composition"
# and ANTI_PATTERNS.md rules 1 v4 + 5 v4.
GENERATOR_MODELS=deepseek/deepseek-v4-flash,meta-llama/llama-4-maverick,qwen/qwen3.6-flash,google/gemini-3.1-flash-lite,openai/gpt-5.4-nano,minimax/minimax-m2.7,z-ai/glm-5,xiaomi/mimo-v2.5
GENERATOR_WEIGHTS=0.30,0.20,0.10,0.10,0.10,0.10,0.05,0.05
GENERATOR_REASONING_EFFORTS=medium,disabled,disabled,disabled,disabled,disabled,disabled,disabled

# match_generator (default) | fixed. fixed falls back to README_MODEL below.
README_ROTATION_MODE=match_generator
README_MODEL=anthropic/claude-haiku-4.5

# Hard cap on effective output cost per model (nominal x reasoning multiplier).
# validate_pool_pricing aborts the tick if any pool member breaches it.
MAX_OUTPUT_PRICE_USD_PER_M=2.00

# Committed-path workflow: per-generation probability of sampling the
# committed-QA vibecoder cohort (article-stuffed context, forced reasoning-
# enabled model, raised build-retry cap). Independent of input score per
# ANTI_PATTERNS rule 5 v4. See OPERATIONS.md "Committed-path workflow".
COMMITTED_PATH_PROBABILITY=0.07
COMMITTED_PATH_BUILD_ATTEMPTS=4
COMMITTED_PATH_ARTICLE_CHARS=2000

# Legacy single-model knob; superseded by GENERATOR_MODELS above for the
# generator and verifier stages. Kept for backward-compat / single-model dev.
GENERATOR_MODEL=deepseek/deepseek-v4-flash

# =========================================================================
# GitHub
# =========================================================================
GITHUB_TOKEN=
GITHUB_ORG=vibemill-apps

# =========================================================================
# Vercel
# =========================================================================
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# =========================================================================
# Supabase
# =========================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# =========================================================================
# Resend (V1+, deferred for V0)
# =========================================================================
RESEND_API_KEY=
RESEND_FROM_ADDRESS=mill@vibemill.dev

# =========================================================================
# Local config
# =========================================================================
VIBEMILL_PATH=/home/ian/vibemill
SQLITE_PATH=/home/ian/vibemill/data/vibemill.sqlite
LOG_LEVEL=INFO

# Spending guardrail. Cap on cumulative OpenRouter + web-search cost in
# the current UTC calendar day. When reached, the tick completes cleanly
# (no abort/error) and the next cron tick re-checks. Manual reset:
# `python -m vibemill reset-daily-cost`. Default tightened from 5.00 to
# 3.00 in v0.5 for the three-tier output calibration.
DAILY_COST_CAP_USD=3.00

# Web search (used by tier 2/3 generations to ground in real data; see
# OPERATIONS.md "Three-tier output calibration"). tavily is the default
# provider; swap by writing clients/<provider>.py + a branch in
# web_search._dispatch.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=your-tavily-api-key-here
WEB_SEARCH_MAX_QUERIES=6

# Live app cap (rotation retires older apps to maintain this)
LIVE_APP_CAP=100

# Viral thresholds
VIRAL_VIEWS_PER_DAY=10000
VIRAL_CONCURRENT_USERS=2000

# Bundle H: Python rail via Hugging Face Spaces.
# HF_USERNAME is the personal account or org under which Spaces are created.
HF_TOKEN=hf-token-here
HF_USERNAME=your-hf-username
