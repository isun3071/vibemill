# Vibe Mill environment template.
# Copy to .env and populate. Do NOT commit the populated .env.

# =========================================================================
# LLM provider (OpenRouter handles all model calls)
# =========================================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model identifiers (swappable). Defaults are reasonable.
GUARD_MODEL=anthropic/claude-haiku-4.5
MATCHER_MODEL=anthropic/claude-haiku-4.5
GENERATOR_MODEL=deepseek/deepseek-chat-v3
README_MODEL=anthropic/claude-haiku-4.5

# =========================================================================
# GitHub
# =========================================================================
GITHUB_TOKEN=
GITHUB_ORG=vibemill-apps

# =========================================================================
# Vercel
# =========================================================================
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# =========================================================================
# Supabase
# =========================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# =========================================================================
# Resend (V1+, deferred for V0)
# =========================================================================
RESEND_API_KEY=
RESEND_FROM_ADDRESS=mill@vibemill.dev

# =========================================================================
# Local config
# =========================================================================
VIBEMILL_PATH=/home/ian/vibemill
SQLITE_PATH=/home/ian/vibemill/data/vibemill.sqlite
LOG_LEVEL=INFO

# Spending guardrail. The orchestrator aborts a cron tick if cumulative
# OpenRouter cost in the current calendar day exceeds this number of USD.
DAILY_COST_CAP_USD=5.00

# Live app cap (rotation retires older apps to maintain this)
LIVE_APP_CAP=100

# Viral thresholds
VIRAL_VIEWS_PER_DAY=10000
VIRAL_CONCURRENT_USERS=2000
