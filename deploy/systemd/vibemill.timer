[Unit]
Description=Vibe Mill cron tick (every 4 hours)

[Timer]
# Per CLAUDE.md v3, the mill runs in bursts every 4 hours rather than hourly.
# Six ticks per day at 02/06/10/14/18/22 local time, with 15 minutes of
# jitter so we are not hitting external APIs on the clock-tick mark.
OnCalendar=*-*-* 02,06,10,14,18,22:00:00
RandomizedDelaySec=15min
Persistent=true
Unit=vibemill.service

[Install]
WantedBy=timers.target
