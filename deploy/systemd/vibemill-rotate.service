[Unit]
Description=Vibe Mill rotation (retire oldest live apps once per day)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=isun3071
Group=isun3071
WorkingDirectory=/home/isun3071/vibemill
EnvironmentFile=/home/isun3071/vibemill/.env
ExecStart=/home/isun3071/.local/bin/uv run python -m vibemill rotate
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600

# Sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/isun3071/vibemill /home/isun3071/.cache/uv

[Install]
WantedBy=multi-user.target
